@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/OsterLib.cmake")
get_filename_component(_dir "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_prefix "${_dir}/../../.." ABSOLUTE)
set(OsterLib_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
check_required_components(OsterLib)
